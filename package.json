{
  "name": "HabitTracker",
  "author": "Alexis Roehrling",
  "description": "A local first, pwa-enabled, simple habit tracker for e-ink tablets",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@marcomattes/epaper-components": "1.2.0",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/ui": "4.1.11",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
